# Copy this file to server/.env and fill in real values.
# Never commit the real .env file — it's already gitignored.

# SMTP transport (example: Gmail — use an App Password, not your normal password:
# https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact form submissions get delivered
CONTACT_TO_EMAIL=chaurasiyavinod96@gmail.com

# Server port
PORT=5000

# Frontend origin allowed to call this API (Vite dev server by default)
ALLOWED_ORIGIN=http://localhost:5173
